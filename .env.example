# AI Biz Brewery — Environment Variables
# Copy this file to .env.local and fill in your values

# -----------------------------------------------
# Anthropic Claude API (required for all AI tools)
# Get your key at: https://console.anthropic.com/
# -----------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------
# MongoDB Atlas (required for database)
# Format: mongodb+srv://user:password@cluster.mongodb.net/aibizbrewer?retryWrites=true&w=majority
# Get your URI at: https://www.mongodb.com/cloud/atlas
# -----------------------------------------------
MONGODB_URI=

# -----------------------------------------------
# NextAuth.js (required for authentication)
# Generate secret: openssl rand -base64 32
# NEXTAUTH_URL must match your domain (e.g. https://your-app.vercel.app)
# -----------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------
# Google OAuth (required for Google login)
# Create credentials at: https://console.cloud.google.com/
# -----------------------------------------------
GOOGLE_ID=
GOOGLE_SECRET=

# -----------------------------------------------
# Stripe (required for payments)
# Get keys at: https://dashboard.stripe.com/apikeys
# -----------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------
# Resend (required for emails)
# Get your key at: https://resend.com/
# -----------------------------------------------
RESEND_API_KEY=
